[Unit]
Description=Voice Server (FastAPI + edge-tts + Sherpa-ONNX)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/voice_server
# Activate venv and start uvicorn
ExecStart=/opt/voice_server/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8090 --workers 1
Restart=always
RestartSec=5
# Environment
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/voice_server
# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=voice-server

[Install]
WantedBy=multi-user.target
